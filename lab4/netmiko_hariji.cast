[4173.320807, "o", "\u001b[1;1H\u001b[35mimport\u001b[m yaml\r\n\u001b[35mfrom\u001b[m jinja2 \u001b[35mimport\u001b[m Environment, FileSystemLoader\r\n\u001b[35mfrom\u001b[m netmiko \u001b[35mimport\u001b[m Netmiko\r\nhosts = yaml.load(\u001b[36mopen\u001b[m(\u001b[31m'hosts.yml'\u001b[m), Loader=yaml.SafeLoader)\r\ninterfaces = yaml.load(\u001b[36mopen\u001b[m(\u001b[31m'interfaces.yml'\u001b[m), Loader=yaml.SafeLoader)\r\nenv = Environment(loader = FileSystemLoader(\u001b[31m'.'\u001b[m), trim_blocks=\u001b[36mTrue\u001b[m,\r\nautoescape=\u001b[36mTrue\u001b[m)\r\ntemplate = env.get_template(\u001b[31m'interfaces_config_template.j2'\u001b[m)\r\nloopback_config = template.render(data=interfaces)\r\n\u001b[38;5;130mfor\u001b[m host \u001b[38;5;130min\u001b[m hosts[\u001b[31m\"hosts\"\u001b[m]:\r\n net_connect = Netmiko(host = host[\u001b[31m\"name\"\u001b[m],\u001b[12;9Husername = host[\u001b[31m\"username\"\u001b[m],\u001b[13;9Hpassword = host[\u001b[31m\"password\"\u001b[m],\u001b[14;9Hport = host[\u001b[31m\"port\"\u001b[m],\u001b[15;9Hdevice_type = host[\u001b[31m\"type\"\u001b[m])\r\n \u001b[36mprint\u001b[m(f\u001b[31m\"Logged into {host['name']} successfully\"\u001b[m)\r\n output = net_connect.send_config_set(loopback_config.split(\u001b[31m\"\u001b[m\u001b[35m\\n\u001b[m\u001b[31m\"\u001b[m))\r\n \u001b[36mprint\u001b[m(f\u001b[31m\"Pushed config into {host"]
